# ==============================================================================
# AI-Powered Restaurant Recommendation System - Environment Configuration
# ==============================================================================

# Hugging Face Dataset
HF_DATASET_NAME=ManikaSaini/zomato-restaurant-recommendation
RAW_DATA_PATH=data/raw/zomato_hf.csv

# Relational Database (SQLite)
DATABASE_URL=sqlite:///data/processed/restaurants.db
ASYNC_DATABASE_URL=sqlite+aiosqlite:///data/processed/restaurants.db

# Vector Store (ChromaDB) & Embeddings
CHROMA_PERSIST_DIRECTORY=data/embeddings/chroma
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# LLM Configuration (Options: "groq", "gemini", "openai", "mock")
LLM_PROVIDER=groq
GROQ_API_KEY=GROQ_ZOMATO_KEY
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=3.0
LLM_MAX_TOKENS=1500

# Hybrid Pre-Ranking Weights (Must sum to 1.0)
WEIGHT_SEMANTIC=0.5
WEIGHT_RATING=0.3
WEIGHT_POPULARITY=0.2

# Budget Tier Thresholds (in INR)
BUDGET_LOW_MAX=500
BUDGET_MEDIUM_MAX=1500

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
